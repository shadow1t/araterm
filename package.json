{
  "name": "araterm",
  "version": "0.1.0",
  "description": "Arabic-first terminal emulator — typed and program-output Arabic both render correctly, powered by the arafix engine (contextual shaping + BiDi). Electron + node-pty + @xterm/headless.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "arabic",
    "terminal",
    "bidi",
    "rtl",
    "shaping",
    "electron",
    "arafix"
  ],
  "dependencies": {
    "@xterm/headless": "^5.5.0",
    "arafix": "github:shadow1t/arafix",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "electron": "^33.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shadow1t/araterm.git"
  },
  "bugs": {
    "url": "https://github.com/shadow1t/araterm/issues"
  },
  "homepage": "https://github.com/shadow1t/araterm#readme",
  "license": "MIT",
  "author": "Rasheed (shadow1t)"
}
